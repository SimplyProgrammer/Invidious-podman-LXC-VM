+
+// truncateFailureDiagnostic limits retained diagnostic text by Unicode characters.
+func truncateFailureDiagnostic(value string) string {
+	value = strings.ToValidUTF8(value, "�")
+	runes := []rune(value)
+	if len(runes) > 1024 {
+		return string(runes[:1024])
+	}
+	return value
+}
